{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quinta",
  "version": "0.1.0",
  "identifier": "io.github.imqstr.Quinta",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Quinta", "width": 1040, "height": 690, "minWidth": 760, "minHeight": 520, "decorations": false, "transparent": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
